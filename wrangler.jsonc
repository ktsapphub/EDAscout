{
  "$schema": "node_modules/wrangler/config-schema.json",
  // EDAScout: one Cloudflare Worker serves the dashboard (./public) and the /api routes.
  "name": "edascout",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // ktsapps.com is on this Cloudflare account, so DNS + TLS are created on deploy.
  "routes": [{ "pattern": "edascout.ktsapps.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edascout",
      "database_id": "40f50a4c-e417-4cdd-a170-3da9eeece09d",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "46681e25a2ae4c229060ec6ece06812d" }],
  "ai": { "binding": "AI" },
  // Cloudflare Browser Run: only used as a fallback when a site refuses a plain request (403/429/5xx).
  "browser": { "binding": "BROWSER" },
  // Daily run 10:00 UTC (6:00 AM EDT / 5:00 AM EST). Weekly roll-up is written on Mondays after the daily run.
  "triggers": { "crons": ["0 */6 * * *"] },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://edascout.ktsapps.com",
    "MAX_LLM_CALLS_PER_RUN": "40",
    "MAX_ITEMS_PER_SOURCE": "8"
  },
  // Staging: own Worker, own D1 + KV (never the production ones). Deployed by pushing the `staging` branch.
  // Refresh its data from production with the "Staging · copy production data" workflow (GitHub → Actions).
  "env": {
    "staging": {
      "name": "edascout-staging",
      "routes": [{ "pattern": "edascout-staging.ktsapps.com", "custom_domain": true }],
      "d1_databases": [{ "binding": "DB", "database_name": "edascout-staging", "database_id": "f4583617-e0ea-4de7-b932-5d60cc65c53c", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "KV", "id": "a5d50bba49144d309129365e01f5279b" }],
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      // One refresh a day keeps the sandbox current without doubling AI usage; "Run scan now" works any time.
      "triggers": { "crons": ["30 11 * * *"] },
      "vars": { "APP_ENV": "staging", "APP_URL": "https://edascout-staging.ktsapps.com", "MAX_LLM_CALLS_PER_RUN": "40", "MAX_ITEMS_PER_SOURCE": "8" }
    }
  }
  // Optional secrets (any subset, never committed): OPENAI_API_KEY, GEMINI_API_KEY, XAI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY
}
